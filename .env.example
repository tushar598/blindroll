# Copy to .env.local at the REPO ROOT (not apps/web) and fill in. Never commit real values.
# The app (next.config.ts) and scripts/ both load that one file; `pnpm env:check` reports missing names.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
BLINDROLL_CONTRACT_ID=blindroll.<your-account>.testnet
USDC_TOKEN_ID=usdc.<your-account>.testnet          # mock on testnet; native USDC on mainnet (never the mock)
RELAYER_ACCOUNT_ID=relayer.<your-account>.testnet
RELAYER_PRIVATE_KEY=ed25519:...                     # never commit
NEAR_AI_API_KEY=...                                 # never commit
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash                    # small model; listed on docs.near.ai/cloud/models
NEAR_AI_LIVE=0                                      # 1 = allow live NEAR AI Cloud calls
ONECLICK_BASE_URL=https://1click.chaindefuser.com/v0
ONECLICK_JWT=...                                    # partners.near-intents.org; never commit
ONECLICK_MODE=dry                                   # dry | live (live only on mainnet)
# TESTNET ONLY, optional. Stand-in for a 1Click deposit address (1Click has no testnet): simulated
# cross-chain claims pay test USDC here, and a simulated refund really sends it back to the contract.
# Leave both empty to keep cross-chain options unselectable. Must be empty on mainnet.
SIM_SINK_ACCOUNT_ID=
SIM_SINK_PRIVATE_KEY=                               # never commit
# Optional. Approvers of the seeded demo org, comma-separated (default: tushar1962005.testnet,tushar-approver2.testnet).
# Applies to runs finalized afterwards. Threshold stays 2.
DEMO_ORG_APPROVERS=
# Optional. The account that gets unclaimed funds back after the deadline (default: tushar1962005.testnet).
# Use an account you hold in a browser wallet. Applies to runs created on-chain afterwards.
DEMO_ORG_REFUND_ACCOUNT=
# Optional. Narrows the NEAR wallets offered (default: all of meteor-wallet, intear-wallet). Comma-separated; Meteor is always kept. Leave empty to offer every wallet.
NEAR_WALLETS=
# Optional. Where the SQLite database lives (default: <repo>/data/blindroll.sqlite). On a host, a path on the persistent volume.
BLINDROLL_DB_FILE=
DATA_ENCRYPTION_KEY=base64-32-bytes
SESSION_SECRET=...
APP_URL=http://localhost:3000
