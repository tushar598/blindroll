{
  "name": "blindroll",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "vectors": "pnpm --filter @blindroll/core vectors",
    "test:contracts": "cd contracts && cargo test",
    "env:check": "pnpm --filter @blindroll/core exec tsx ../../scripts/check-env.mts",
    "ai:record": "pnpm --filter @blindroll/core exec tsx ../../scripts/record-ai-fixture.mts",
    "oneclick:record": "pnpm --filter @blindroll/core exec tsx ../../scripts/record-oneclick-fixture.mts",
    "relayer:check": "pnpm --filter @blindroll/core exec tsx ../../scripts/relayer-check.mts",
    "simsink:check": "pnpm --filter @blindroll/core exec tsx ../../scripts/sim-sink-check.mts",
    "report:verify": "pnpm --filter @blindroll/core exec tsx ../../scripts/verify-report.mts"
  }
}
